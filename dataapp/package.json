{
  "name": "zero-trust-search",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "A private breach-intelligence search workspace for authorized cybersecurity analysts.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['dist','dist-test']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "check:browser": "node --check static/assets/search.js && node --check static/assets/spatial.js && node --check static/assets/explorer.js",
    "check": "npm run typecheck && npm run check:browser && npm test && npm run build",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "watch": "tsc -p tsconfig.json --watch",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "express": "5.3.0",
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mustache": "4.2.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
