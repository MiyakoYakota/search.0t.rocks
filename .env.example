# run.sh creates a random token when neither .env nor API_TOKEN exists.
# If copying this file to .env, replace the blank value with at least 32 characters.
# Example generator: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
API_TOKEN=
WEB_PORT=3000
SOLR_HEAP=512m

# Native development only (Compose supplies its own internal values):
# HOST=127.0.0.1
# PORT=3000
# SOLR_URL=http://127.0.0.1:8983/solr
# SOLR_COLLECTION=BigData
# SOLR_TIMEOUT_MS=5000
# MAX_RESULTS=100
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
